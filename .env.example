# Copie ce fichier vers .env.local puis remplis les deux valeurs.
# Supabase > Project Settings > API (ou "Connect").

# URL du projet, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique : "publishable key" (sb_publishable_...) ou ancienne clé "anon".
# Elle n'est pas secrète : les données sont protégées par la RLS.
# Ne mets JAMAIS ici la clé "secret" / "service_role".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Recommandations (facultatif) ---------------------------------------------
# Clé API Anthropic (https://console.anthropic.com). Côté serveur uniquement :
# ne JAMAIS la préfixer par NEXT_PUBLIC_. Sans clé, l'app rédige les
# recommandations en mode démonstration (règles simples, sans IA).
ANTHROPIC_API_KEY=

# Modèle utilisé (par défaut claude-haiku-5-5, le moins cher).
# Exemple pour une rédaction plus fine : ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MODEL=
